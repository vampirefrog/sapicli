<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v5 source for the sapisrv Windows Installer.
  See deploy/README.md for the build / install / uninstall commands.

  Layout the installer expects under DistDir (the build workflow stages this):
    dist/
      sapicli.exe
      sapisrv.exe
      keys.default.json
      www/...                          (web client + WASM)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <?define UpgradeCode = "5e1c7f2a-3b4d-4e8f-9a1c-7d3e5f8b2a91" ?>

  <Package
    Name="sapicli SAPI HTTP Server"
    Manufacturer="vampi.tech"
    Version="$(var.Version)"
    UpgradeCode="$(var.UpgradeCode)"
    Scope="perMachine"
    InstallerVersion="500">

    <SummaryInformation Description="sapicli SAPI HTTP Server" />
    <MediaTemplate EmbedCab="yes" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <!-- HTTP port the service listens on. Override with msiexec via -->
    <!--   msiexec /i sapisrv-setup.msi PORT=9090 /quiet              -->
    <!-- The property is Public (uppercase) and Secure so it survives -->
    <!-- the immediate->deferred boundary the netsh CAs cross.        -->
    <Property Id="PORT" Value="8080" Secure="yes" />

    <!-- UI: WixUI_Minimal gives a single Welcome+License dialog with an -->
    <!-- Install button, then progress, then a Finish (Exit) dialog so   -->
    <!-- the user gets visual confirmation that the install succeeded.   -->
    <!-- Requires the WixToolset.UI.wixext extension at build time:      -->
    <!--   wix build ... -ext WixToolset.UI.wixext                       -->
    <ui:WixUI Id="WixUI_Minimal" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.DistDir)\License.rtf" />

    <!-- Optional checkbox on the Finish dialog: "Open in browser". -->
    <!-- The service is already started by InstallServices/ServiceControl -->
    <!-- by the time the user sees this dialog, so launching the URL just  -->
    <!-- works (modulo a few hundred ms of HTTP-listener warm-up that the  -->
    <!-- user spends reading the dialog).                                  -->
    <!-- WixShellExec lives in WixToolset.Util.wixext; build line needs    -->
    <!-- `-ext WixToolset.Util.wixext` alongside the UI extension.         -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open the sapisrv web UI in my browser" />
    <!-- Set WixShellExecTarget at runtime so [PORT] formats from the live -->
    <!-- session properties (a default Property value is a literal string  -->
    <!-- and would put the brackets straight into the URL).                -->
    <CustomAction Id="SetLaunchTarget" Property="WixShellExecTarget"
                  Value="http://localhost:[PORT]/" />
    <CustomAction Id="LaunchBrowser" DllEntry="WixShellExec" Impersonate="yes"
                  BinaryRef="Wix4UtilCA_X64" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="SetLaunchTarget"
               Order="998"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchBrowser"
               Order="999"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <!-- Install root: %ProgramFiles%\sapisrv\ -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="sapisrv" />
    </StandardDirectory>

    <!-- Per-machine config: %ProgramData%\sapicli\ -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="ProgramDataSapicli" Name="sapicli">
        <Directory Id="ProgramDataSapicliLogs" Name="logs" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="sapisrv" Level="1" Display="expand">
      <ComponentGroupRef Id="ProgramFilesGroup" />
      <ComponentGroupRef Id="ProgramDataGroup" />
    </Feature>

    <!-- ===== Files in Program Files ===== -->
    <ComponentGroup Id="ProgramFilesGroup">

      <!-- CLI tool (no service, just an installed binary) -->
      <Component Directory="INSTALLFOLDER">
        <File Source="$(var.DistDir)\sapicli.exe" />
      </Component>

      <!-- Helper script for first-install keys.json generation. Stays on -->
      <!-- disk after install so an operator can re-run it manually to    -->
      <!-- regenerate the public-trial key.                                -->
      <Component Directory="INSTALLFOLDER">
        <File Id="GenKeysScript" Source="$(var.DistDir)\gen-keys.ps1" />
      </Component>

      <!-- sapisrv.exe + Windows Service registration + start/stop control -->
      <Component Directory="INSTALLFOLDER">
        <File Id="SapisrvExe" Source="$(var.DistDir)\sapisrv.exe" KeyPath="yes" />
        <ServiceInstall
          Id="SapisrvServiceInstall"
          Name="sapisrv"
          DisplayName="sapicli SAPI HTTP Server"
          Description="Serves SAPI text-to-speech over HTTP, with parallel speech-event multiplexing."
          Type="ownProcess"
          Start="auto"
          ErrorControl="normal"
          Account="NT AUTHORITY\NetworkService"
          Arguments="run --port=[PORT]"
          Vital="yes" />
        <ServiceControl
          Id="ControlSapisrv"
          Name="sapisrv"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
      </Component>

      <!-- Web UI (HTML/CSS/JS + WASM + sprites). Auto-harvested into www/ -->
      <Files Include="$(var.DistDir)\www\**" Directory="INSTALLFOLDER" Subdirectory="www" />
    </ComponentGroup>

    <!-- ===== Files in ProgramData ===== -->
    <ComponentGroup Id="ProgramDataGroup">

      <!-- Make sure ProgramData\sapicli\ and the logs subdir exist. Both -->
      <!-- are Permanent="yes" so uninstall doesn't take the operator's   -->
      <!-- keys.json or accumulated logs with it.                          -->
      <Component Id="SapicliDir" Directory="ProgramDataSapicli"
                 Guid="b2a3b4c5-6d7e-8f90-a1b2-c3d4e5f60718" Permanent="yes">
        <CreateFolder />
      </Component>
      <Component Id="LogsDir" Directory="ProgramDataSapicliLogs"
                 Guid="c3b4c5d6-7e8f-90a1-b2c3-d4e5f6071829" Permanent="yes">
        <CreateFolder />
      </Component>
    </ComponentGroup>

    <!-- ===== Custom actions: URL ACL ===== -->
    <!-- HTTP API on Windows requires an explicit URL reservation per-account.
         We delete-then-add for idempotence on dev machines where a previous
         reservation may exist under a different user; without this, the new
         install would silently be left with a stale ACL the service can't
         bind through.

         Execute="immediate" (not deferred) so [PORT] resolves at format-time
         from the session properties; the per-machine MSI session already
         runs elevated so netsh has the rights it needs. -->

    <CustomAction Id="ResetUrlAcl"
      Directory="INSTALLFOLDER"
      ExeCommand='cmd.exe /c "netsh http delete urlacl url=http://+:[PORT]/ &amp; netsh http add urlacl url=http://+:[PORT]/ user=&quot;NT AUTHORITY\NetworkService&quot;"'
      Execute="immediate"
      Return="check" />

    <CustomAction Id="RemoveUrlAcl"
      Directory="INSTALLFOLDER"
      ExeCommand='netsh http delete urlacl url=http://+:[PORT]/'
      Execute="immediate"
      Return="ignore" />

    <!-- Run gen-keys.ps1 once on first install to write a randomised        -->
    <!-- keys.json with a public-trial key. The script no-ops if keys.json   -->
    <!-- already exists, so re-running is safe across upgrades and repairs.  -->
    <!--                                                                      -->
    <!-- Two CAs: Type 51 SetGenKeysData stuffs INSTALLFOLDER into the named  -->
    <!-- property "GenerateKeysJson", which becomes [CustomActionData] when   -->
    <!-- the deferred CA of the same name runs. Deferred CAs can't see        -->
    <!-- session properties directly: referencing [INSTALLFOLDER] in          -->
    <!-- ExeCommand resolves to empty string and PowerShell then can't find   -->
    <!-- the script.                                                           -->
    <CustomAction Id="SetGenKeysData" Property="GenerateKeysJson" Value="[INSTALLFOLDER]" />
    <CustomAction Id="GenerateKeysJson"
      Directory="INSTALLFOLDER"
      ExeCommand='powershell.exe -NoProfile -ExecutionPolicy Bypass -File "[CustomActionData]gen-keys.ps1"'
      Execute="deferred"
      Impersonate="no"
      Return="check" />

    <InstallExecuteSequence>
      <!-- Reset on every install/upgrade/repair so a stale ACL can't strand -->
      <!-- the service. Run before InstallServices so the service start that  -->
      <!-- WiX schedules right after has a working reservation in place.      -->
      <Custom Action="ResetUrlAcl"      Before="InstallServices" Condition="NOT REMOVE" />
      <!-- SetGenKeysData must precede GenerateKeysJson so the latter sees    -->
      <!-- a populated CustomActionData. Both run after InstallFiles so the   -->
      <!-- script is on disk, then before InstallServices so keys.json        -->
      <!-- exists when the service starts.                                     -->
      <Custom Action="SetGenKeysData"   After="InstallFiles"     Condition="NOT REMOVE" />
      <Custom Action="GenerateKeysJson" After="SetGenKeysData"   Condition="NOT REMOVE" />
      <Custom Action="RemoveUrlAcl"     Before="RemoveFiles"     Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

  </Package>
</Wix>
